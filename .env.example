# SalesLore configuration. Copy to .env and fill in. Never commit .env.
# Offline mode needs none of this: npm run offline

# --- Postgres (live mode) ---
# The app's least-privilege login (created by db/sql/07_app_role.sql).
DATABASE_URL=postgresql://saleslore_app:CHANGE_ME@localhost:5432/saleslore
# An admin login you own, used only by `npm run db:setup`.
DATABASE_ADMIN_URL=postgresql://localhost:5432/saleslore
# Optional: db:setup sets the saleslore_app password from this. Use the same value as in DATABASE_URL.
SALESLORE_DB_PASSWORD=
# Optional: connection pool size (default 5).
SALESLORE_DB_POOL_MAX=5

# --- Web console ---
# 127.0.0.1 keeps the console on this computer only. Use 0.0.0.0 to open it to your network.
SALESLORE_HOST=127.0.0.1
PORT=3000

# --- Wording ---
# scripted (default, offline, deterministic) or anthropic (live model phrases the summary only).
MODEL=scripted
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Slack (optional) ---
# Bot token starts with xoxb-, app-level token with xapp-. See docs/SETUP_SLACK.md.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Map Slack user IDs to SalesLore users so approvals know who you are: U0123ABC=dana,U0456DEF=leo
SALESLORE_SLACK_USER_MAP=
